# Practacu Press —— 生产 profile 的环境文件模板
#
# 复制到仓库根目录并命名为 .env.prod，填好后：
#   cp deploy/production/env.prod.example .env.prod
#   chmod 600 .env.prod
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.prod up -d --build
#
# 这个文件包含站点签名私钥：视同口令，不要提交 git，不要放进可公开访问的备份。
# 完整步骤、密钥生成、备份与升级见 docs/deployment/production-profile.md。

# --- 必填 ---------------------------------------------------------------
# base64 PKCS#8 Ed25519 私钥，单行、无换行。生成命令（任选一种）：
#
#   # OpenSSL（Linux / macOS / Git Bash）
#   openssl genpkey -algorithm ED25519 -out jwt_keys.pem
#   openssl pkey -in jwt_keys.pem -outform DER -out jwt_key.der
#   base64 -w0 jwt_key.der; echo
#
#   # PowerShell（Windows，需要 OpenSSL 在 PATH 中）
#   openssl genpkey -algorithm ED25519 -out jwt_keys.pem
#   openssl pkey -in jwt_keys.pem -outform DER -out jwt_key.der
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes('jwt_key.der'))
#
#   # Go（与启动器 state.go 相同的生成逻辑；保存为 genkey.go 后 go run genkey.go）
#   package main
#   import ("crypto/ed25519"; "crypto/rand"; "crypto/x509"; "encoding/base64"; "fmt")
#   func main() {
#       _, key, _ := ed25519.GenerateKey(rand.Reader)
#       der, _ := x509.MarshalPKCS8PrivateKey(key)
#       fmt.Println(base64.StdEncoding.EncodeToString(der))
#   }
#
# 私钥一旦更换，所有已登录会话立即失效（JWT 无法再验证），需要重新登录。
AUTH_JWT_ED25519_PRIVATE_KEY=

# 对外访问地址。必须是浏览器实际访问的地址：生产是 https 域名；桌面 / localhost
# 通过 http 访问时必须显式写成 http://127.0.0.1:<端口>，因为未设置时系统假定 https。
# 找回密码邮件、通知邮件与第三方登录回调都用它拼绝对链接。
PUBLIC_BASE_URL=https://press.example.com

# --- 可选调优 -----------------------------------------------------------
# 每 IP 每分钟 API 请求上限。0 关闭；生产建议 120–240，并在反代层再加 limit_req。
RATE_LIMIT_PER_MINUTE=240

# 累计媒体额度（字节）。默认 512 MiB/成员、10 GiB/站点；后台可分别覆盖。
# 设置为 0 表示无限制；修改后重启 API 生效。
MEDIA_DEFAULT_USER_QUOTA_BYTES=536870912
MEDIA_DEFAULT_SITE_QUOTA_BYTES=10737418240

# 邮件（找回密码）可选。不设置 SMTP_HOST 时找回密码接口会明确返回不可用。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
