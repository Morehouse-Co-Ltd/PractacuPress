# ============================================================================
# Practacu Press —— 内容页元数据（SEO / 社交分享卡片）的 Nginx 等价方案
#
# 文件名带 .example：`deploy/linux/install.sh` 不会 include 它，
# 现有的 locations.conf.in / site.conf.in / tls.conf.in 也一个字都不用改。
# 想用哪一段，把对应的片段复制进你自己的 server 块或 conf.d。
#
# 背景
# ----
# 前台是单页应用。`/a/{id}`、`/p/{id}` 的内容元数据有两条来源：
#
#   1. 浏览器里：`web/src/lib/seo.ts` 在 React 渲染后写 <head>；
#   2. 抓取器：**不执行 JS**，只能读 HTML 源码。
#
# `web/scripts/serve.mjs`（`npm start` 起的静态服务器）已经把第 2 条补上了：
# 先 `GET {PP_API_BASE}/api/v1/{articles|posts}/{id}` 取内容元数据，把 <title> /
# description / og:* / twitter:card / canonical / robots 注入 `dist/index.html`
# 再返回；按 (Host, 路径) 缓存 60 秒，超时 800ms，失败就原样返回外壳。
#
# **Nginx 自己做不到这件事**：它不会去 API 取数据，也不会跑 JS。所以下面是两条
# 等价路线：
#
#   A. 把 /a/、/p/ 的 HTML 请求 proxy_pass 到 Node 静态服务器（即 serve.mjs）
#      —— 与 `npm start` / 桌面版行为完全一致，推荐。
#   B. sub_filter（只够做站点级常量）或 prerender 中间件（能跑 JS）
#      —— 同机跑不了 Node、或已经有现成的 prerender 服务时用。
#
# 何时用哪个
# ----------
# * 同机能跑 Node（`npm start`，或给 Linux 安装目录加一个 systemd 单元）
#     → 用 A。零额外依赖，源站行为和桌面版一致；代价是多一次本机反向代理。
# * 纯静态托管（对象存储 / CDN / 只给 FTP 的空间）
#     → 用 B2 的 prerender；或干脆关掉这条路，接受默认卡片。
# * 只想在卡片上补站点名、站点默认图这类**全站常量**
#     → 用 B1 的 sub_filter。它读不到单篇内容，别指望它能出每篇不同的标题。
# ============================================================================


# ----------------------------------------------------------------------------
# 方案 A —— 把内容页的 HTML 请求转给 Node 静态服务器
#
# 前置（示例路径，按你的部署改）：
#   /opt/pp-static/scripts/serve.mjs   ← 复制自 web/scripts/serve.mjs
#   /opt/pp-static/dist/               ← web/dist 的内容（serve.mjs 按
#                                          “脚本上一级 + /dist” 找静态产物）
#
# 启动（只监听回环，由 Nginx 对外）：
#   PP_WEB_HOST=127.0.0.1 \
#   PP_API_BASE=http://127.0.0.1:8081 \
#     node /opt/pp-static/scripts/serve.mjs --port 8090
#
#   · PP_API_BASE 要指向 **Go API**。serve.mjs 的默认值是本机 8080；而
#     `deploy/linux/install.sh` 默认把 API 放在 8081（API_PORT），所以 Linux
#     安装形态下必须显式设置，否则取不到元数据（页面照旧能打开，只是退化成默认卡片）。
#   · 端口 8090 随便挑一个空闲端口，别和站点端口/API 端口撞。
#   · 这个 Node 进程不需要对外暴露：只让 Nginx 通过回环访问即可。
#
# ⚠ 下面两段（map 与 upstream）必须写在 http{} 里——例如
#   /etc/nginx/conf.d/practacu-seo.conf 的顶层，或 nginx.conf 的 http 块内。
#   放进 server{} 里 Nginx 会直接报错起不来。
# ----------------------------------------------------------------------------

# 只有「导航请求」才值得转发：Accept 里带 text/html 的才是读者/抓取器打开的页面；
# JSON 探测、预检之类的请求保持原来的行为（走 SPA 兜底）。
map $http_accept $pp_wants_html {
    default        0;
    "~*text/html"  1;
}

# 同机 Node 静态服务（serve.mjs）。端口换成你自己的。
upstream pp_static {
    server 127.0.0.1:8090;
    keepalive 8;
}

server {
    # …… 你的 listen / server_name / TLS 配置照旧（见 site.conf.in、tls.conf.in）……

    # 内容详情页：/a/{id} 与 /p/{id}。
    # 正则 location 优先于下面的 `location /`，两者不会打架；
    # `^/(a|p)/` 也不会误伤 /api/、/assets/、/atom.xml（那些是 /a… 但接着不是 /）。
    location ~ ^/(a|p)/ {
        # 非 HTML 请求就地落到原来的 SPA 兜底（418 只在本文件内部用，不对外）。
        if ($pp_wants_html = 0) {
            return 418;
        }
        error_page 418 = @pp_spa_fallback;

        # Node 挂了也要能打开站点：退回不带元数据的 index.html，而不是 502。
        error_page 502 503 504 = @pp_spa_fallback;

        proxy_pass http://pp_static;
        proxy_http_version 1.1;

        # Host 必须原样传过去：API 按 Host 解析站点，Node 再把同一个 Host 转给 API。
        # 站点绑了非标准端口时用 $http_host（它保留端口号）。
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        # canonical / og:url 的协议来自这里；漏了它，https 站点会拼出 http://。
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Node 侧对 API 的等待上限是 800ms，这里留出余量即可。
        proxy_connect_timeout 2s;
        proxy_read_timeout    5s;
    }

    # 原来的 SPA 兜底（`try_files $uri $uri/ /index.html;`）继续服务首页、
    # 列表页、搜索结果等其它路由。
    location @pp_spa_fallback {
        root      /opt/practacu-press/web;   # 与 locations.conf.in 的 WEB_ROOT 一致
        try_files /index.html =404;
    }

    # 两个注意点：
    #
    # 1) Nginx 的 add_header 不跨层继承：上面两个 location 里一旦写了任何
    #    add_header，server 级的 CSP / X-Frame-Options 等安全头就不再生效，
    #    需要重新声明一遍，或 include 一份共用的 headers 片段。
    #    （locations.conf.in 里对 /assets/ 就是这么处理的。）
    #
    # 2) /__pp/ 运行时接口仍然必须挡住（沿用 `location /__pp/ { return 404; }`）。
    #    本方案只接管 /a/、/p/，不会把控制面暴露出去。
}


# ----------------------------------------------------------------------------
# 方案 B1 —— sub_filter：只能替换站点级常量
#
# sub_filter 做的是**字符串替换**，不会去 API 取数据。它只能处理 HTML 里已经
# 写死的占位符，例如站点名、站点默认分享图。想让每篇内容有不同的 <title>，
# sub_filter 给不了（除非你自己起一个上游服务取数据，那其实就是方案 A）。
#
# 需要 ngx_http_sub_module（Debian/Ubuntu 的 nginx-full 自带，nginx-light 没有）。
# 另外上游压缩过的响应换不了，所以给它 `proxy_set_header Accept-Encoding ""`。
# ----------------------------------------------------------------------------
# server {
#     location = /index.html {
#         sub_filter_once off;                      # 默认只换第一处
#         sub_filter 'PP_SITE_NAME' '你的站点名';    # 值里不能带单引号
#         sub_filter 'PP_SITE_DESCRIPTION' '一句话介绍';
#         proxy_set_header Accept-Encoding "";
#     }
# }


# ----------------------------------------------------------------------------
# 方案 B2 —— prerender 中间件：能跑 JS，效果等价于 A
#
# 把「疑似抓取器」的请求转给一个无头浏览器（Rendertron / prerender.io / 自建
# puppeteer 服务），由它执行 JS 后返回完整 HTML。效果接近 A，但成本高一个数量级：
# 每个 URL 都要跑一次浏览器。
#
# UA 判断会误伤（UA 可以伪造），所以务必：
#   · 只把白名单 UA 交给 prerender；
#   · prerender 侧有自己的缓存（同一 URL 别跑第二遍）；
#   · 给 prerender 限流，别让「伪造 UA」变成压垮服务器的开关。
#
# 想省掉无头浏览器，也可以用 B2 的路由 + 方案 A 的服务：
#   `proxy_pass http://pp_static;`（把 prerender 换成 serve.mjs 的注入）。
# ----------------------------------------------------------------------------
# map $http_user_agent $pp_prerender {
#     default                  0;
#     "~*googlebot"            1;
#     "~*bingbot"              1;
#     "~*baiduspider"          1;
#     "~*twitterbot"           1;
#     "~*facebookexternalhit"  1;
#     "~*telegrambot"          1;   # Telegram
#     "~*micromessenger"       1;   # 微信
#     "~*slackbot"             1;
# }
#
# server {
#     location ~ ^/(a|p)/ {
#         if ($pp_prerender = 0) {
#             return 418;
#         }
#         error_page 418 = @pp_spa_fallback;
#         error_page 502 503 504 = @pp_spa_fallback;
#
#         proxy_pass http://127.0.0.1:3000/render?url=$scheme://$host$request_uri;
#         proxy_set_header Host              $host;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_read_timeout 15s;               # 跑浏览器比读 API 慢得多
#     }
#     location @pp_spa_fallback {
#         root      /opt/practacu-press/web;
#         try_files /index.html =404;
#     }
# }


# ----------------------------------------------------------------------------
# 验收清单（配好之后这样确认）
# ----------------------------------------------------------------------------
#   # 1. 用抓取器的 UA 取一篇内容，源码里应该有真实标题，而不是站点名：
#   curl -sS -H 'Accept: text/html' -H 'Host: press.example.com' \
#        -A 'Twitterbot/1.0' http://127.0.0.1/a/<id> \
#        | grep -E '<title>|og:title|og:url|canonical|robots'
#
#   # 2. 直接问 Node 静态服务（绕过 Nginx），确认注入逻辑本身生效：
#   curl -sS -H 'Accept: text/html' -H 'Host: press.example.com' \
#        http://127.0.0.1:8090/a/<id> | head -n 20
#
#   # 3. 停掉 API 再试第 1 步：必须仍然 200，只是卡片退回默认值（不能 5xx）。
#
#   # 4. https 站点核对 canonical / og:url 的完整地址（协议、端口、域名）。
# ============================================================================
