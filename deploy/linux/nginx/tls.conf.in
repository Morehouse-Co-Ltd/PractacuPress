# Practacu Press —— 公网 HTTPS 站点
# 由 install.sh 生成；要改模板请改 deploy/linux/nginx/tls.conf.in。

map $http_upgrade $pp_connection_upgrade {
    default upgrade;
    ''      '';
}

# 80 端口：只保留 ACME 挑战与跳转，其余一律去 HTTPS。
server {
    listen 80;
    server_name @@DOMAIN@@;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root @@ACME_ROOT@@;
        default_type text/plain;
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # 兼容 Nginx 1.24（Ubuntu 24.04 等）；1.25+ 的 `http2 on;` 写法在下方注释。
    listen 443 ssl http2;
    # listen 443 ssl;
    # http2 on;
    server_name @@DOMAIN@@;
    server_tokens off;

    ssl_certificate     @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PP_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include @@LOCATIONS_CONF@@;
}
