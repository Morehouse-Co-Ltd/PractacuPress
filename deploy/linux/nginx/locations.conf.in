# Practacu Press —— 由 install.sh 生成，请不要直接改这个文件；
# 要改模板请改仓库里的 deploy/linux/nginx/locations.conf.in 后重新安装或升级。
#
# 这段被站点与 TLS 两份配置 include 进 server 块。
#
# 前端已经通过 go:embed 编进 Go API，所以 Nginx 只做 TLS/域名/限流边缘，
# 所有请求（文档、静态资源、SPA 路由、/api、RSS、sitemap）都反代到同一个
# 回环 API。不要再配置 root/try_files：否则静态站会绕过 API 内嵌产物，
# 升级后也容易出现旧 index.html + 新 assets 的错配。

# Nginx 的上限只作为第一道保护；API 按路由执行自己的 25 MiB / 512 MiB 限制。
client_max_body_size 512m;

# HTTP/1.1 + 空的 Connection 头让到 API 的 upstream 连接可以复用；
# 只有 WebSocket 升级请求才切换成 upgrade。
proxy_http_version 1.1;
proxy_set_header Connection $pp_connection_upgrade;

# 安全响应头与启动器 / API 版本保持一致。
# frame-src 必须含 'self'：页面编排用同源 iframe 预览真实前台；
# frame-ancestors 才是防别的站嵌本站的开关。
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://*.hcaptcha.com https://www.gstatic.com; script-src 'self' https://challenges.cloudflare.com https://js.hcaptcha.com https://www.google.com https://www.gstatic.com; frame-src 'self' https: http:; connect-src 'self' https://challenges.cloudflare.com https://*.hcaptcha.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
add_header X-Content-Type-Options "nosniff" always;

# 启动器控制面绝不对外。
location = /__pp { return 404; }
location /__pp/ { return 404; }

# certbot 的 HTTP-01 挑战目录（只在需要签证书的形态下真的有人访问）。
location /.well-known/acme-challenge/ {
    root @@ACME_ROOT@@;
    default_type text/plain;
    access_log off;
}

# 其余全部交给 API：它同时提供内嵌 SPA、/api、RSS/Atom、sitemap/robots
# 与扩展 bundle。读超时放宽到 30 分钟，覆盖媒体下载与 WebSocket。
location / {
    proxy_pass http://@@APP_ADDR@@;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $pp_connection_upgrade;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
}
