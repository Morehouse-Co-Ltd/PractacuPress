[Unit]
Description=Practacu Press
Documentation=file://@@INSTALL_DIR@@/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
EnvironmentFile=@@ENV_FILE@@
WorkingDirectory=@@DATA_DIR@@
ExecStart=@@INSTALL_DIR@@/bin/practacu-press
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@DATA_DIR@@
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
