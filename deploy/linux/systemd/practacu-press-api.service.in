[Unit]
Description=Practacu Press API
Documentation=file://@@INSTALL_DIR@@/INSTALL.md
After=network-online.target
Wants=network-online.target
# 安全检查、HTML 清洗与上传扫描都在 API 进程内完成，没有独立的安全服务单元。

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
EnvironmentFile=@@ENV_FILE@@
WorkingDirectory=@@DATA_DIR@@
ExecStart=@@INSTALL_DIR@@/bin/practacu-press
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@DATA_DIR@@
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
