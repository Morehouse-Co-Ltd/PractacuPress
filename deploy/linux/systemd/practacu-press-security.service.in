[Unit]
Description=Practacu Press security service (Argon2id, HTML sanitizing, upload checks)
Documentation=file://@@INSTALL_DIR@@/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=@@INSTALL_DIR@@/bin/practacu-security
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@DATA_DIR@@

[Install]
WantedBy=multi-user.target
