# 本地部署密钥（.env.example 仍然入库）
.env
.env.*
!.env.example

# 编辑器与本地工具目录
/.idea/
/.workbuddy/

# Build artifacts
*.exe
*.test
*.out

# Local runtime state
*.db
*.db-shm
*.db-wal
/data/
/backups/

# Dependencies and generated caches
node_modules/
/web/dist/
/web/.runtime/
.DS_Store
Thumbs.db

# Windows 启动器打包产物
/release/

# Rust build artifacts
target/
.tmpbuild/

# 本地临时产物（冒烟测试打包输出）
.tmp/
web/.tmp/

# 扩展打包产物（scripts/package-extension.ps1 输出）与示例的 WASM 构建产物
/dist/
plugins/examples/**/backend/*.wasm

# 本地浏览器 profile（截图/审计工具产生的 Chrome 缓存，含 Cookie，勿入库）
*.prof/
*.prof2/

# 冒烟测试遗留的注册凭据（含 JWT）
/.reg.json

# pnpm 本地内容寻址存储（历史遗留的依赖缓存，勿入库）
/.pnpm-store/

# 本地打好的发行压缩包（约 1 GB，超过 GitHub 单文件上限，只在本地留存）
/Practacu Press.zip

# 设计与审计文档只留在本地（约 36 MB，含大量截图），不进仓库也不再推送。
# 需要分享时单独脱敏后发送，或临时 `git add -f docs/...`。
/docs/

# Generated frontend embedded into the Go API; only the marker is committed.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
