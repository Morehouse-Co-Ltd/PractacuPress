# Configuration reference. Copy to .env and edit, or set the variables in your shell.
# The server loads the nearest .env (up to the module root); variables already set
# in the environment win. scripts\dev.ps1 sets development defaults for all of these.

# --- required -------------------------------------------------------------
# development | test | production
# production requires a persistent AUTH_JWT_ED25519_PRIVATE_KEY and PP_DESKTOP=false;
# see docs/deployment/production-profile.md for the hardened Docker profile.
APP_ENV=development
# 本地单站点：启动时自动建表、创建默认站点，并把首个注册账户提升为平台管理员。
# 生产 overlay / 多站点部署必须改为 false；APP_ENV=production 与 true 互斥。
PP_DESKTOP=true

# sqlite | mysql | postgres. The DSN is passed to the driver untouched; for SQLite the
# server adds the required pragmas (foreign keys, WAL, busy timeout) itself.
DATABASE_DRIVER=sqlite
DATABASE_DSN=file:./data/practacu.db

# Security checks (Argon2id, HTML sanitization, upload inspection) run inside the API.
# The old SECURITY_GRPC_ADDR / SECURITY_GO_GRPC_ADDR variables are no longer read.

# --- http ---------------------------------------------------------------
# The API only serves this machine: the desktop launcher proxies it under the same
# origin, so the port never needs to face the LAN. A non-loopback value such as
# 0.0.0.0:8080 fails at startup unless PP_ALLOW_REMOTE_API=1 is set explicitly.
HTTP_ADDR=127.0.0.1:8080
# PP_ALLOW_REMOTE_API=1

# Comma separated browser origins. Empty disables cross origin access entirely.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Requests per client per minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=240

# HTTP server timeouts. A slow request must not pin a connection forever; idle
# keep-alive connections are recycled sooner when the second value is smaller.
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=120

# Per request deadline. Cancels the request's work (which frees its database
# connection) and bounds the response write. The WebSocket upgrade and media
# downloads are exempt because they are legitimately long lived; that exemption is
# also why the server sets no global WriteTimeout. 0 disables it.
HTTP_REQUEST_TIMEOUT_SECONDS=30

# Largest request body any handler may read, in bytes. Uploads carry their own larger
# ceiling derived from the media module's attachment limit. 0 disables the cap.
MAX_REQUEST_BODY_BYTES=4194304

# Database pool. 0 keeps the driver defaults (SQLite 1, MySQL/Postgres 25).
# 0 for lifetime disables recycling; the default is 30 minutes.
DB_MAX_OPEN_CONNS=0
DB_MAX_IDLE_CONNS=0
DB_CONN_MAX_LIFETIME_SECONDS=1800

# CIDRs or IPs whose X-Forwarded-* headers are believed. Empty trusts no proxy.
TRUSTED_PROXIES=

# --- authentication ------------------------------------------------------
# base64 PKCS#8 Ed25519 key. Required when APP_ENV=production; development generates an
# ephemeral key and warns. Generate one with the commands in
# docs/deployment/production-profile.md and keep it out of version control.
# AUTH_JWT_ED25519_PRIVATE_KEY=
# AUTH_JWT_KID=
AUTH_JWT_ISSUER=practacu-press

# --- data at rest ---------------------------------------------------------
# base64 32-byte AES-256 key that seals personal fields: login addresses, phone
# numbers and private message bodies. Required when APP_ENV=production. Without it
# development keeps a key file at data/.field-encryption.key. Generate with
# `openssl rand -base64 32`. Losing it makes the sealed fields unrecoverable, and
# rotating it needs a decrypt/re-encrypt migration, so treat it like the signing key.
# FIELD_ENCRYPTION_KEY=

# Whole-instance backup packages are sealed with this second 32-byte key (a distinct
# key from FIELD_ENCRYPTION_KEY: this one may live off the server). BACKUP_ENCRYPTION
# defaults to on when the key is set; production requires it. Restoring a .ppbak
# needs the same key, and a lost key voids the backup.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION=on

# Budget for the endpoints that consume a password (register, login, password reset),
# per client per minute, on top of RATE_LIMIT_PER_MINUTE. Each accepted attempt costs one
# Argon2 hash, so this tier keeps a credential stuffing run off that path. 0 disables it.
AUTH_CREDENTIAL_RATE_LIMIT_PER_MINUTE=10

# Cookies are always Secure in production. Set COOKIE_SECURE=false to override when
# terminating TLS in front of the API during a staging test. The production Docker
# profile (docker-compose.prod.yml) sets COOKIE_SECURE=true explicitly.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Used for single site deployments where host resolution finds nothing.
# DEFAULT_SITE_ID=

# Docker 单主机安装专用：端口映射会隐藏真实客户端地址，严格的回环校验会让安装
# 向导无法创建第一个管理员。只在对外端口绑定 127.0.0.1 时设置；完成安装后可以删掉。
# 生产环境（PP_DESKTOP=false）会忽略这个值。
# PP_FIRST_ADMIN_TRUST_PROXY=1

# Deployment-wide accumulated media limits in bytes. Site and member overrides are
# managed from the admin console. Defaults are 512 MiB per member and 10 GiB per site;
# set 0 for unlimited.
MEDIA_DEFAULT_USER_QUOTA_BYTES=536870912
MEDIA_DEFAULT_SITE_QUOTA_BYTES=10737418240

# --- storage -------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/media
# Where admin-created instance backups and their metadata sidecars are written.
BACKUP_DIR=./data/backups

# Required when STORAGE_DRIVER=s3.
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# Leave the endpoint empty for AWS; set it for MinIO and other compatible stores.
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_PREFIX=

# Per-purpose overrides. SCOPE is CONTENT, SITE, AVATAR or ATTACHMENT.
# DRIVER defaults to inherit (use the global storage above); local or s3 can override.
# local without STORAGE_<SCOPE>_LOCAL_DIR uses <STORAGE_DIR>/<scope>.
# s3 requires STORAGE_<SCOPE>_S3_BUCKET and reuses the global endpoint/region/credentials;
# an empty prefix uses <STORAGE_S3_PREFIX>/<scope>.
# STORAGE_CONTENT_DRIVER=inherit
# STORAGE_CONTENT_LOCAL_DIR=
# STORAGE_CONTENT_S3_BUCKET=
# STORAGE_CONTENT_S3_PREFIX=
# STORAGE_SITE_DRIVER=inherit
# STORAGE_SITE_LOCAL_DIR=
# STORAGE_SITE_S3_BUCKET=
# STORAGE_SITE_S3_PREFIX=
# STORAGE_AVATAR_DRIVER=inherit
# STORAGE_AVATAR_LOCAL_DIR=
# STORAGE_AVATAR_S3_BUCKET=
# STORAGE_AVATAR_S3_PREFIX=
# STORAGE_ATTACHMENT_DRIVER=inherit
# STORAGE_ATTACHMENT_LOCAL_DIR=
# STORAGE_ATTACHMENT_S3_BUCKET=
# STORAGE_ATTACHMENT_S3_PREFIX=

# --- mail (SMTP) ---------------------------------------------------------
# Optional. Without SMTP_HOST the password reset flow reports itself as unavailable:
# the API refuses to promise an email it cannot send. STARTTLS on 587 is the common
# case; use SMTP_ENCRYPTION=ssl for port 465. Credentials are only accepted together,
# and only over TLS unless the relay is on localhost.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# Defaults to SMTP_USERNAME, which is what most relays require.
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Practacu Press

# Origin used in absolute links (password reset mail, notification mail, third party
# login callbacks). When unset, links built without a request context assume https —
# correct behind a TLS proxy, wrong for a desktop or localhost install reached over
# plain http. Such an install must set it explicitly, e.g.
# PUBLIC_BASE_URL=http://127.0.0.1:8080.
# PUBLIC_BASE_URL=https://press.example.com

# --- human verification (CAPTCHA) ----------------------------------------
# Optional server secrets. The site settings page chooses the provider, the public
# Site Key and which forms are protected; these variables are what make that choice
# enforceable. A provider without a secret is reported as "not enforced" by
# GET /api/v1/captcha/status, the settings page shows it as missing, and the server
# logs a warning instead of pretending to check tokens. The secrets are never sent
# to the browser and never stored in the site configuration.
#
# The built-in "local" provider needs no variable at all: the API process issues a
# short-lived arithmetic challenge itself. It is single-process by nature, so a
# multi-instance deployment should use Turnstile or hCaptcha instead.
# CAPTCHA_TURNSTILE_SECRET=
# CAPTCHA_HCAPTCHA_SECRET=
# Upper bound for one siteverify call; a slower provider answer is treated as a
# retryable failure instead of holding the login request open.
# CAPTCHA_TIMEOUT_SECONDS=5
# Optional siteverify URL overrides, for tests or an egress gateway. Leave unset in
# production so the provider's official endpoint is used.
# CAPTCHA_TURNSTILE_URL=
# CAPTCHA_HCAPTCHA_URL=

# --- in-process security ------------------------------------------------
# At most SECURITY_ARGON2_CONCURRENCY (1-32) concurrent Argon2 computations, each
# with a SECURITY_ARGON2_TIMEOUT_MS (100-60000) deadline. Defaults: 1-4 (CPU
# derived) and 10000 ms.
# SECURITY_ARGON2_CONCURRENCY=2
# SECURITY_ARGON2_TIMEOUT_MS=10000

# --- optional modules -----------------------------------------------------
# Disabling the admin performance panel removes GET /api/v1/system/metrics and
# its background sampler (route + goroutine) from the process. Default: enabled.
# PP_SYSTEM_METRICS=off

