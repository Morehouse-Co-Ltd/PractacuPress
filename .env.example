# Practacu Press environment / 环境配置
# Copy to .env and edit; the server loads it automatically.
# 复制为 .env 后修改，服务会自动加载；已存在的环境变量优先。
# Existing environment variables win. / 已有环境变量优先。

# development | test | production
APP_ENV=development
# Local single-site bootstrap; use false for production / SaaS.
# 本地单站点引导；生产或多站点部署设为 false。
PP_DESKTOP=true

# sqlite | mysql | postgres
DATABASE_DRIVER=sqlite
DATABASE_DSN=file:./data/practacu.db

# Loopback by default; remote access requires PP_ALLOW_REMOTE_API=1.
# 默认只监听回环；对外开放需显式设置 PP_ALLOW_REMOTE_API=1。
HTTP_ADDR=127.0.0.1:8080

# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/media
BACKUP_DIR=./data/backups

# Maximum article and post source length in Unicode characters. The storage
# strategy page can override this after settings are applied at runtime.
# MAX_CONTENT_SOURCE_CHARS=1000000

# Absolute links: use http for localhost, https behind TLS.
# 绝对链接前缀：本地用 http，生产 TLS 后用 https。
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Production secrets; development may leave them empty.
# 生产密钥；开发环境可留空。
# AUTH_JWT_ED25519_PRIVATE_KEY=
# AUTH_JWT_ISSUER=practacu-press
# FIELD_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY=

# In-process security tuning. / 内置安全检查调优。
# SECURITY_ARGON2_CONCURRENCY=2
# SECURITY_ARGON2_TIMEOUT_MS=10000
